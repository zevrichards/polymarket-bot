# Polymarket live-trading credentials.
# Copy this file to .env and fill in real values.
# NEVER commit .env to git -- it is listed in .gitignore.
#
# How to get these values:
#   1. Export your MetaMask wallet private key:
#      MetaMask → click account name → Account details → Export private key
#   2. Run: .venv\Scripts\python.exe -m scripts.setup_credentials
#      This generates the API key/secret/passphrase and writes them to .env.
#   3. Add POLY_PRIVATE_KEY to .env manually (setup_credentials does not store it).

POLY_PRIVATE_KEY=0x_your_metamask_private_key_here
POLY_API_KEY=your_api_key_here
POLY_API_SECRET=your_api_secret_here
POLY_API_PASSPHRASE=your_api_passphrase_here
# V2 deposit wallet address — find it in DevTools: place any order in the web UI
# and read order.maker from the POST /order request body.
POLY_DEPOSIT_WALLET=0xa23d2F995FD9C03AAC2eBefa79795Df2365CA32D

# Polygon RPC for Chainlink BTC/USD (used by oracle_bot; not required for lag_bot).
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
